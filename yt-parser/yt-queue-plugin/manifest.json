{
  "manifest_version": 3,
  "name": "YT Enqueue",
  "version": "1.0",
  "description": "Добавить YouTube-видео в очередь yt-parser",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Добавить в YT-очередь"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-enqueue@local",
      "strict_min_version": "109.0"
    }
  }
}
