# pg-tune — Python 3.12 + PostgreSQL 18 client tools
#
# Dev image: includes pytest, ruff, sqlfluff. For production, use a
# separate Dockerfile that runs `uv sync --no-dev`.
#
# Pinned uv version — see https://github.com/astral-sh/uv/releases
# when upgrading.

FROM python:3.12-slim-bookworm

# ---- PostgreSQL 18 client from PGDG -------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && . /etc/os-release \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
      http://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-18 \
 && apt-get purge -y --auto-remove curl gnupg \
 && rm -rf /var/lib/apt/lists/*

# ---- uv (pinned) --------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

# ---- Application --------------------------------------------------
WORKDIR /app

# Docker-friendly uv defaults:
#   UV_LINK_MODE=copy         — hardlinks do not work across overlayfs
#   UV_COMPILE_BYTECODE=1     — precompile, faster cold start
#   UV_PYTHON_DOWNLOADS=never — use the system Python from the base image
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

# Dependency layer — cached until manifests change.
COPY pyproject.toml uv.lock .python-version ./
COPY pg-tune/pyproject.toml pg-tune/pyproject.toml
RUN uv sync --frozen --no-install-project --all-packages

# Project layer — invalidated on any source change.
COPY src/ src/
COPY pg-tune/src/ pg-tune/src/
COPY config/ config/
COPY pg-tune/config/ pg-tune/config/
COPY tests/ tests/
COPY pg-tune/tests/ pg-tune/tests/
RUN uv sync --frozen --all-packages

CMD ["uv", "run", "pg-tune-mcp"]

